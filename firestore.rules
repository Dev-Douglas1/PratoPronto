rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function estaLogado() {
      return request.auth != null;
    }

    function ehDono(userId) {
      return estaLogado() && request.auth.uid == userId;
    }

    function emailEhAdminDeTeste() {
      return estaLogado()
        && request.auth.token.email is string
        && request.auth.token.email == 'douglas.souza.santos@escola.pr.gov.br';
    }

    function ehAdmin() {
      return estaLogado() && (
        emailEhAdminDeTeste()
        || (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'restaurant_admin'
        )
      );
    }

    function textoValido(valor, maximo) {
      return valor is string && valor.size() <= maximo;
    }

    function perfilValido() {
      return request.resource.data.keys().hasOnly([
               'nome', 'email', 'telefone', 'endereco', 'numero', 'bairro',
               'complemento', 'aceitarMarketing', 'privacyPolicyVersion',
               'termsVersion', 'consentTimestamp', 'updatedAt'
             ])
             && request.resource.data.keys().hasAll([
               'nome', 'email', 'telefone', 'endereco', 'numero', 'bairro',
               'complemento', 'aceitarMarketing', 'privacyPolicyVersion',
               'termsVersion', 'consentTimestamp', 'updatedAt'
             ])
             && textoValido(request.resource.data.nome, 100)
             && request.resource.data.nome.size() > 0
             && textoValido(request.resource.data.email, 254)
             && textoValido(request.resource.data.telefone, 30)
             && request.resource.data.telefone.size() > 0
             && textoValido(request.resource.data.endereco, 180)
             && request.resource.data.endereco.size() > 0
             && textoValido(request.resource.data.numero, 20)
             && request.resource.data.numero.size() > 0
             && textoValido(request.resource.data.bairro, 100)
             && request.resource.data.bairro.size() > 0
             && textoValido(request.resource.data.complemento, 180)
             && request.resource.data.aceitarMarketing is bool
             && textoValido(request.resource.data.privacyPolicyVersion, 40)
             && textoValido(request.resource.data.termsVersion, 40)
             && textoValido(request.resource.data.consentTimestamp, 50)
             && request.resource.data.updatedAt == request.time
             && request.auth.token.email is string
             && request.resource.data.email == request.auth.token.email;
    }

    function clienteValido(cliente) {
      return cliente is map
             && cliente.keys().hasOnly(['nome', 'email', 'telefone'])
             && textoValido(cliente.nome, 100)
             && cliente.nome.size() > 0
             && textoValido(cliente.email, 254)
             && textoValido(cliente.telefone, 30)
             && cliente.telefone.size() > 0
             && cliente.email == request.auth.token.email;
    }

    function entregaValida(entrega) {
      return entrega is map
             && entrega.keys().hasOnly(['endereco', 'numero', 'bairro', 'complemento'])
             && textoValido(entrega.endereco, 180)
             && entrega.endereco.size() > 0
             && textoValido(entrega.numero, 20)
             && entrega.numero.size() > 0
             && textoValido(entrega.bairro, 100)
             && entrega.bairro.size() > 0
             && textoValido(entrega.complemento, 180);
    }

    function pagamentoValido(pagamento) {
      return pagamento is map
             && pagamento.keys().hasOnly(['metodo', 'referencia'])
             && textoValido(pagamento.metodo, 80)
             && pagamento.metodo.size() > 0
             && textoValido(pagamento.referencia, 180);
    }

    function statusValido(status) {
      return status in [
        'recebido', 'preparando', 'pronto', 'saiu_entrega', 'entregue',
        'cancelamento_solicitado', 'cancelado', 'Pedido confirmado • preparando'
      ];
    }

    function refundStatusValido(status) {
      return status in ['none', 'requested', 'approved', 'rejected', 'refunded'];
    }

    match /users/{userId} {
      allow create: if ehDono(userId) && perfilValido();
      allow read: if ehDono(userId) || ehAdmin();
      allow update: if ehDono(userId)
        && perfilValido()
        && request.resource.data.email == resource.data.email
        && request.resource.data.privacyPolicyVersion == resource.data.privacyPolicyVersion
        && request.resource.data.termsVersion == resource.data.termsVersion
        && request.resource.data.consentTimestamp == resource.data.consentTimestamp;
      allow delete: if ehDono(userId);
    }

    match /admins/{userId} {
      allow read: if ehDono(userId) || ehAdmin();

      // Bootstrap temporário do administrador de teste. Em produção, substitua
      // por Custom Claims/Admin SDK e remova o e-mail de teste destas regras.
      allow create: if ehDono(userId)
        && emailEhAdminDeTeste()
        && request.resource.data.keys().hasOnly([
          'email', 'role', 'permissions', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'restaurant_admin'
        && request.resource.data.permissions is list
        && request.resource.data.permissions.size() <= 20
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update, delete: if ehAdmin();
    }

    match /orders/{orderId} {
      allow create: if estaLogado()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'userId', 'cliente', 'entrega', 'itens', 'subtotal', 'deliveryFee',
          'total', 'observacao', 'pagamento', 'paymentStatus', 'status',
          'cancelReason', 'refundStatus', 'refundReason', 'assignedCourier',
          'restaurantNotes', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'userId', 'cliente', 'entrega', 'itens', 'subtotal', 'deliveryFee',
          'total', 'observacao', 'pagamento', 'paymentStatus', 'status',
          'cancelReason', 'refundStatus', 'refundReason', 'assignedCourier',
          'restaurantNotes', 'createdAt', 'updatedAt'
        ])
        && clienteValido(request.resource.data.cliente)
        && entregaValida(request.resource.data.entrega)
        && request.resource.data.itens is list
        && request.resource.data.itens.size() > 0
        && request.resource.data.itens.size() <= 50
        && request.resource.data.subtotal is number
        && request.resource.data.subtotal > 0
        && request.resource.data.subtotal <= 50000
        && request.resource.data.deliveryFee is number
        && request.resource.data.deliveryFee >= 0
        && request.resource.data.deliveryFee <= 1000
        && request.resource.data.total is number
        && request.resource.data.total >= request.resource.data.subtotal + request.resource.data.deliveryFee - 0.01
        && request.resource.data.total <= request.resource.data.subtotal + request.resource.data.deliveryFee + 0.01
        && request.resource.data.total <= 51000
        && textoValido(request.resource.data.observacao, 500)
        && pagamentoValido(request.resource.data.pagamento)
        && request.resource.data.paymentStatus in ['demo_approved', 'pending_delivery']
        && request.resource.data.status == 'recebido'
        && request.resource.data.cancelReason == ''
        && request.resource.data.refundStatus == 'none'
        && request.resource.data.refundReason == ''
        && request.resource.data.assignedCourier == ''
        && request.resource.data.restaurantNotes == ''
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow read: if estaLogado() && (resource.data.userId == request.auth.uid || ehAdmin());

      allow update: if ehAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'paymentStatus', 'cancelReason', 'refundStatus', 'refundReason',
          'assignedCourier', 'restaurantNotes', 'updatedAt'
        ])
        && statusValido(request.resource.data.status)
        && refundStatusValido(request.resource.data.refundStatus)
        && textoValido(request.resource.data.cancelReason, 300)
        && textoValido(request.resource.data.refundReason, 300)
        && textoValido(request.resource.data.assignedCourier, 100)
        && textoValido(request.resource.data.restaurantNotes, 500)
        && textoValido(request.resource.data.paymentStatus, 80)
        && request.resource.data.updatedAt == request.time;

      allow update: if estaLogado()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'cancelReason', 'updatedAt'
        ])
        && request.resource.data.status == 'cancelamento_solicitado'
        && resource.data.status in ['recebido', 'preparando', 'pronto', 'saiu_entrega', 'Pedido confirmado • preparando']
        && textoValido(request.resource.data.cancelReason, 300)
        && request.resource.data.updatedAt == request.time;

      allow update: if estaLogado()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'refundStatus', 'refundReason', 'updatedAt'
        ])
        && resource.data.status in ['entregue', 'cancelado']
        && request.resource.data.refundStatus == 'requested'
        && resource.data.refundStatus in ['none', 'rejected']
        && textoValido(request.resource.data.refundReason, 300)
        && request.resource.data.updatedAt == request.time;

      allow delete: if estaLogado() && resource.data.userId == request.auth.uid;
    }

    match /reviews/{orderId} {
      allow create: if estaLogado()
        && !exists(/databases/$(database)/documents/reviews/$(orderId))
        && exists(/databases/$(database)/documents/orders/$(orderId))
        && get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid
        && get(/databases/$(database)/documents/orders/$(orderId)).data.status == 'entregue'
        && request.resource.data.keys().hasOnly([
          'orderId', 'userId', 'displayName', 'foodRating', 'deliveryRating',
          'comment', 'restaurantReply', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.orderId == orderId
        && request.resource.data.userId == request.auth.uid
        && textoValido(request.resource.data.displayName, 80)
        && request.resource.data.foodRating is int
        && request.resource.data.foodRating >= 1
        && request.resource.data.foodRating <= 5
        && request.resource.data.deliveryRating is int
        && request.resource.data.deliveryRating >= 1
        && request.resource.data.deliveryRating <= 5
        && textoValido(request.resource.data.comment, 800)
        && request.resource.data.restaurantReply == ''
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow read: if estaLogado() && (resource.data.userId == request.auth.uid || ehAdmin());

      allow update: if ehAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['restaurantReply', 'updatedAt'])
        && textoValido(request.resource.data.restaurantReply, 800)
        && request.resource.data.updatedAt == request.time;

      allow delete: if estaLogado() && (resource.data.userId == request.auth.uid || ehAdmin());
    }

    match /catalog/{productId} {
      allow read: if estaLogado();
      allow create, update: if ehAdmin()
        && request.resource.data.keys().hasOnly(['available', 'stock', 'price', 'updatedAt'])
        && request.resource.data.available is bool
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.stock <= 100000
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && request.resource.data.price <= 10000
        && request.resource.data.updatedAt == request.time;
      allow delete: if ehAdmin();
    }

    match /settings/delivery {
      allow read: if estaLogado();
      allow create, update: if ehAdmin()
        && request.resource.data.keys().hasOnly(['defaultFee', 'freeOver', 'areas', 'updatedAt'])
        && request.resource.data.defaultFee is number
        && request.resource.data.defaultFee >= 0
        && request.resource.data.defaultFee <= 1000
        && request.resource.data.freeOver is number
        && request.resource.data.freeOver >= 0
        && request.resource.data.freeOver <= 50000
        && request.resource.data.areas is list
        && request.resource.data.areas.size() <= 100
        && request.resource.data.updatedAt == request.time;
      allow delete: if ehAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function logged() { return request.auth != null; }
    function sameUser(uid) { return logged() && request.auth.uid == uid; }
    function owner(uid) { return verified() && sameUser(uid); }
    function verified() { return logged() && request.auth.token.email_verified == true; }
    function legacyAdmin() {
      return verified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'restaurant_admin';
    }
    function admin() { return legacyAdmin(); }
    function companyId(data) { return data.get('companyId', 'pratopronto'); }
    function memberPath(cid) { return /databases/$(database)/documents/companyMembers/$(cid + '_' + request.auth.uid); }
    function companyMember(cid) {
      return verified() && exists(memberPath(cid))
        && get(memberPath(cid)).data.companyId == cid
        && get(memberPath(cid)).data.userId == request.auth.uid
        && get(memberPath(cid)).data.get('active', true) == true;
    }
    function companyRole(cid) { return companyMember(cid) ? get(memberPath(cid)).data.role : ''; }
    function companyStaff(cid) {
      return (cid == 'pratopronto' && legacyAdmin())
        || (companyMember(cid) && companyRole(cid) in ['owner','admin','member','kitchen','support']);
    }
    function companyManager(cid) {
      return (cid == 'pratopronto' && legacyAdmin())
        || (companyMember(cid) && companyRole(cid) in ['owner','admin']);
    }
    function companyOrderOperator(cid) {
      return (cid == 'pratopronto' && legacyAdmin())
        || (companyMember(cid) && companyRole(cid) in ['owner','admin','member','kitchen']);
    }
    function companyReviewer(cid) {
      return (cid == 'pratopronto' && legacyAdmin())
        || (companyMember(cid) && companyRole(cid) in ['owner','admin','member','support']);
    }
    function companySupport(cid) {
      return (cid == 'pratopronto' && legacyAdmin())
        || (companyMember(cid) && companyRole(cid) in ['owner','admin','member','support']);
    }
    function assignedPilot(data) {
      let cid = companyId(data);
      return companyMember(cid) && companyRole(cid) == 'pilot'
        && data.get('assignedCourier', '') == request.auth.uid;
    }
    function text(value, max) { return value is string && value.size() <= max; }
    // BEGIN CONTENT FILTER
    function respectful(value) { return !value.matches("(?is).*(^|[^a-zA-ZÀ-ÿ0-9])(?:p+[\\s._*\\-​-‍]*[o0óòôõö]+[\\s._*\\-​-‍]*r+[\\s._*\\-​-‍]*r+[\\s._*\\-​-‍]*[a4@áàâãä]+|c+[\\s._*\\-​-‍]*[a4@áàâãä]+[\\s._*\\-​-‍]*r+[\\s._*\\-​-‍]*[a4@áàâãä]+[\\s._*\\-​-‍]*l+[\\s._*\\-​-‍]*h+[\\s._*\\-​-‍]*[o0óòôõö]+|m+[\\s._*\\-​-‍]*[e3éèêë]+[\\s._*\\-​-‍]*r+[\\s._*\\-​-‍]*d+[\\s._*\\-​-‍]*[a4@áàâãä]+|p+[\\s._*\\-​-‍]*[uúùûü]+[\\s._*\\-​-‍]*t+[\\s._*\\-​-‍]*[a4@áàâãä]+|p+[\\s._*\\-​-‍]*[uúùûü]+[\\s._*\\-​-‍]*t+[\\s._*\\-​-‍]*[o0óòôõö]+|p+[\\s._*\\-​-‍]*[uúùûü]+[\\s._*\\-​-‍]*t+[\\s._*\\-​-‍]*[a4@áàâãä]+[\\s._*\\-​-‍]*r+[\\s._*\\-​-‍]*[i1!íìîï]+[\\s._*\\-​-‍]*[a4@áàâãä]+|b+[\\s._*\\-​-‍]*[uúùûü]+[\\s._*\\-​-‍]*c+[\\s._*\\-​-‍]*[e3éèêë]+[\\s._*\\-​-‍]*t+[\\s._*\\-​-‍]*[a4@áàâãä]+|f+[\\s._*\\-​-‍]*[o0óòôõö]+[\\s._*\\-​-‍]*d+[\\s._*\\-​-‍]*[a4@áàâãä]+|f+[\\s._*\\-​-‍]*[o0óòôõö]+[\\s._*\\-​-‍]*d+[\\s._*\\-​-‍]*[e3éèêë]+[\\s._*\\-​-‍]*r+|f+[\\s._*\\-​-‍]*[o0óòôõö]+[\\s._*\\-​-‍]*d+[\\s._*\\-​-‍]*[a4@áàâãä]+[\\s._*\\-​-‍]*[s5$]+[\\s._*\\-​-‍]*[e3éèêë]+|f+[\\s._*\\-​-‍]*[o0óòôõö]+[\\s._*\\-​-‍]*d+[\\s._*\\-​-‍]*[i1!íìîï]+[\\s._*\\-​-‍]*d+[\\s._*\\-​-‍]*[o0óòôõö]+|f+[\\s._*\\-​-‍]*[o0óòôõö]+[\\s._*\\-​-‍]*d+[\\s._*\\-​-‍]*[i1!íìîï]+[\\s._*\\-​-‍]*d+[\\s._*\\-​-‍]*[a4@áàâãä]+|[a4@áàâãä]+[\\s._*\\-​-‍]*r+[\\s._*\\-​-‍]*r+[\\s._*\\-​-‍]*[o0óòôõö]+[\\s._*\\-​-‍]*m+[\\s._*\\-​-‍]*b+[\\s._*\\-​-‍]*[a4@áàâãä]+[\\s._*\\-​-‍]*d+[\\s._*\\-​-‍]*[o0óòôõö]+|[a4@áàâãä]+[\\s._*\\-​-‍]*r+[\\s._*\\-​-‍]*r+[\\s._*\\-​-‍]*[o0óòôõö]+[\\s._*\\-​-‍]*m+[\\s._*\\-​-‍]*b+[\\s._*\\-​-‍]*[a4@áàâãä]+[\\s._*\\-​-‍]*d+[\\s._*\\-​-‍]*[a4@áàâãä]+|c+[\\s._*\\-​-‍]*[uúùûü]+[\\s._*\\-​-‍]*z+[\\s._*\\-​-‍]*[a4@áàâãä]+[\\s._*\\-​-‍]*[o0óòôõö]+|c+[\\s._*\\-​-‍]*[uúùûü]+[\\s._*\\-​-‍]*z+[\\s._*\\-​-‍]*[o0óòôõö]+[\\s._*\\-​-‍]*n+[\\s._*\\-​-‍]*[a4@áàâãä]+|v+[\\s._*\\-​-‍]*[i1!íìîï]+[\\s._*\\-​-‍]*[a4@áàâãä]+[\\s._*\\-​-‍]*d+[\\s._*\\-​-‍]*[o0óòôõö]+|v+[\\s._*\\-​-‍]*[i1!íìîï]+[\\s._*\\-​-‍]*[a4@áàâãä]+[\\s._*\\-​-‍]*d+[\\s._*\\-​-‍]*[a4@áàâãä]+)(s)?($|[^a-zA-ZÀ-ÿ0-9]).*"); }
    // END CONTENT FILTER
    function name(value) {
      return text(value,80) && value.size() >= 2
        && value.matches("[\\p{L}\\p{M}][\\p{L}\\p{M} '.’\\-]*") && respectful(value);
    }
    function promotion(p) {
      return p is map && p.keys().hasAll(['titulo','percentual','inicio','fim','ativa'])
        && p.keys().hasOnly(['titulo','percentual','inicio','fim','ativa'])
        && text(p.titulo,60) && p.titulo.size() >= 3 && respectful(p.titulo)
        && p.percentual is int && p.percentual >= 1 && p.percentual <= 90
        && p.inicio is int && p.fim is int && p.inicio > 0 && p.fim > p.inicio
        && p.fim - p.inicio <= 7776000000 && p.fim <= 9007199254740991 && p.ativa is bool;
    }
    function profile(d) {
      return d.keys().hasOnly(['nome','email','telefone','endereco','numero','bairro','complemento','cep','cidade','uf','aceitarMarketing','privacyPolicyVersion','termsVersion','consentTimestamp','updatedAt'])
        && name(d.nome) && text(d.email,254) && d.email == request.auth.token.email
        && text(d.telefone,11) && d.telefone.matches('[1-9][0-9]{9,10}') && text(d.endereco,180) && text(d.numero,20) && text(d.bairro,100) && text(d.complemento,180)
        && text(d.get('cep',''),8) && text(d.get('cidade',''),100) && text(d.get('uf',''),2)
        && d.aceitarMarketing is bool && text(d.privacyPolicyVersion,40) && text(d.termsVersion,40)
        && text(d.consentTimestamp,50) && d.updatedAt == request.time;
    }
    match /users/{uid} {
      allow read: if owner(uid);
      // An unverified account may only submit its own initial registration.
      // It cannot read or modify profiles, orders, roles or verification codes.
      allow create: if sameUser(uid) && !exists(/databases/$(database)/documents/privacyRequests/$(uid)) && profile(request.resource.data);
      allow update: if owner(uid) && !exists(/databases/$(database)/documents/privacyRequests/$(uid)) && profile(request.resource.data);
      // Deletion is a durable server workflow, including pending refunds.
      allow delete: if false;
    }
    match /admins/{uid} {
      allow get: if owner(uid);
      allow write, list: if false;
    }
    match /companies/{companyId} {
      allow read: if resource.data.get('active', false) == true || companyMember(companyId);
      allow write: if false;

      match /settings/{settingId} {
        allow read: if companyStaff(companyId);
        allow write: if false;
      }
      match /products/{productId} {
        allow read: if (resource.data.get('public', false) == true && resource.data.get('disponivel', true) == true)
          || companyStaff(companyId);
        allow write: if false;
      }
    }
    match /companyMembers/{membershipId} {
      allow get: if verified() && (resource.data.userId == request.auth.uid || companyManager(resource.data.companyId));
      allow list: if verified() && (resource.data.userId == request.auth.uid || companyManager(resource.data.companyId));
      allow write: if false;
    }
    match /orders/{orderId} {
      allow read: if owner(resource.data.userId) || companyStaff(companyId(resource.data)) || assignedPilot(resource.data);
      // Pedidos e etapas são alterados somente pelo backend validado.
      allow write: if false;
      match /events/{eventId} {
        function parentOrder() { return get(/databases/$(database)/documents/orders/$(orderId)).data; }
        allow read: if owner(parentOrder().userId) || companyStaff(companyId(parentOrder())) || assignedPilot(parentOrder());
        allow write: if false;
      }
      match /private/{secretId} {
        function parentOrder() { return get(/databases/$(database)/documents/orders/$(orderId)).data; }
        allow read: if secretId == 'delivery' && owner(parentOrder().userId);
        allow write: if false;
      }
    }
    match /refundRequests/{orderId} {
      function refundOrder() { return get(/databases/$(database)/documents/orders/$(orderId)).data; }
      allow get: if owner(refundOrder().userId) || companySupport(companyId(refundOrder()));
      allow list: if owner(resource.data.userId) || companySupport(companyId(resource.data));
      allow write: if false;
    }
    match /reviews/{orderId} {
      function order() { return get(/databases/$(database)/documents/orders/$(orderId)).data; }
      allow get: if owner(order().userId) || companyStaff(companyId(order()));
      allow list: if owner(resource.data.userId) || companyStaff(companyId(resource.data));
      allow delete: if false;
      allow create: if verified() && owner(order().userId) && owner(request.resource.data.userId)
        && order().status == 'entregue' && request.resource.data.orderId == orderId
        && request.resource.data.get('companyId', companyId(order())) == companyId(order())
        && request.resource.data.keys().hasOnly(['companyId','orderId','userId','nome','notaComida','notaEntrega','comentario','createdAt'])
        && name(request.resource.data.nome)
        && request.resource.data.notaComida is int && request.resource.data.notaComida >= 1 && request.resource.data.notaComida <= 5
        && request.resource.data.notaEntrega is int && request.resource.data.notaEntrega >= 1 && request.resource.data.notaEntrega <= 5
        && text(request.resource.data.comentario,1000) && respectful(request.resource.data.comentario) && request.resource.data.createdAt == request.time;
      allow update: if companyReviewer(companyId(resource.data))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resposta','respondidoEm','respondidoPor'])
        && text(request.resource.data.resposta,1000) && respectful(request.resource.data.resposta) && request.resource.data.resposta.size() >= 3
        && request.resource.data.respondidoPor == request.auth.uid && request.resource.data.respondidoEm == request.time;
    }
    match /productSettings/{productId} {
      allow read: if verified();
      allow create, update: if companyManager('pratopronto')
        && productId in ['calabresa','quatro-queijos','estrogonofe','frango-catupiry','mussarela','lombo-canadense','coca-cola','guarana','fanta','sprite','monster','red-bull']
        && request.resource.data.keys().hasOnly(['disponivel','preco','promocao','updatedAt'])
        && (!('promocao' in request.resource.data) || promotion(request.resource.data.promocao))
        && request.resource.data.disponivel is bool && request.resource.data.preco is number
        && request.resource.data.preco > 0 && request.resource.data.preco <= 2000
        && (productId in ['coca-cola','guarana','fanta','sprite','monster','red-bull'] || request.resource.data.preco > 12)
        && request.resource.data.updatedAt == request.time;
    }
    match /settings/{id} { allow read: if companyStaff('pratopronto'); allow write: if false; }
    match /operations/{id} { allow read: if companyManager('pratopronto'); allow write: if false; }
    match /operationAlerts/{id} { allow read: if companyManager('pratopronto'); allow write: if false; }
    match /privacyRequests/{uid} { allow read: if owner(uid) || companyManager('pratopronto'); allow write: if false; }
    // Quotes, provider payments, webhook jobs, limits and secrets are server-only.
    match /{document=**} { allow read, write: if false; }
  }
}

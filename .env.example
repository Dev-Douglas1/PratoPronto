VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

VITE_CONTROLLER_NAME=PratoPronto
VITE_PRIVACY_EMAIL=

# Opcional: configure somente depois de registrar o app no Firebase App Check.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Supabase: use somente a chave Publishable (nunca a service_role/secret key).
# O Firebase continua sendo usado pelo fluxo atual enquanto o Supabase é ativado.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# A operação de pagamentos é configurada no servidor em functions/.env.PROJECT_ID.
# Tokens de pagamento e credenciais administrativas nunca usam o prefixo VITE_.

# Somente no Codespaces/desenvolvimento, após autorizar o token no Firebase.
VITE_FIREBASE_APPCHECK_DEBUG=false

# A interface 2.0 usa functions/. O Worker está preservado como implementação separada.
# Não ative esta chave nesta interface: os contratos de dados são diferentes.
VITE_SECURE_ORDER_BACKEND=false
VITE_SECURE_ORDER_API_URL=
VITE_ENABLE_CARD_DEMO=false

{
  "expo": {
    "name": "PratoPronto",
    "slug": "pratopronto",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "pratopronto",
    "userInterfaceStyle": "light",
    "platforms": [
      "android",
      "ios"
    ],
    "icon": "./public/icons/app-512.png",
    "android": {
      "package": "com.pratopronto.app",
      "adaptiveIcon": {
        "foregroundImage": "./public/icons/app-512.png",
        "backgroundColor": "#FFE317"
      }
    },
    "ios": {
      "bundleIdentifier": "com.pratopronto.app",
      "supportsTablet": true
    },
    "plugins": [
      [
        "expo-web-browser",
        {
          "experimentalLauncherActivity": false
        }
      ]
    ]
  }
}

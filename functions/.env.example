# Server-only parameters. Copy to functions/.env.PROJECT_ID (ignored by Git).
# Use distinct Firebase projects for Mercado Pago test and production.
PAYMENT_ENV=disabled
LIVE_ORDERS_ENABLED=false
APP_PUBLIC_URL=
MP_COLLECTOR_ID=
BACKUP_BUCKET=
SECURITY_EMAIL_FROM=

# Store both secrets using Firebase Secret Manager, never VITE_ variables:
# firebase functions:secrets:set MP_ACCESS_TOKEN --project PROJECT_ID
# firebase functions:secrets:set MP_WEBHOOK_SECRET --project PROJECT_ID
# firebase functions:secrets:set RESEND_API_KEY --project PROJECT_ID
# Generate EMAIL_CODE_SECRET with at least 32 random bytes. Never use a password.
# firebase functions:secrets:set EMAIL_CODE_SECRET --project PROJECT_ID
# Cloud callable functions enforce Firebase App Check.
